# market-proxy config (server/market-proxy.js) — keys stay SERVER-SIDE, never in the browser
EQUITY_PROVIDER=schwab       # schwab | alpaca | webull   (US equities + indices)
CRYPTO_PROVIDER=coinbase     # coinbase (keyless public stats) | alpaca

# Schwab (OAuth2): create an app at developer.schwab.com, do the one-time auth to mint a
# refresh token, then set these. Access tokens are refreshed automatically (~30 min).
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_REFRESH_TOKEN=

# Alpaca (paper keys are fine for market data; free IEX feed). alpaca.markets
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_FEED=iex              # iex (free) | sip (paid)

# Coinbase crypto uses the public exchange stats endpoint (no key needed). For authenticated
# account/portfolio data later, use Coinbase Advanced Trade (CDP key + JWT) in a new module.

PORT=8787
